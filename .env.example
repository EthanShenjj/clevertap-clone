# Optional: absolute path to a persistent SQLite file. Defaults to ./data/clevertap.sqlite
# DATABASE_PATH=/absolute/path/clevertap.sqlite

# SMS: public demo sending works without credentials.
SMS_LIVE_ENABLED=false
# Optional owner-managed live test sending (set privately in Netlify, never NEXT_PUBLIC_*).
# SMS_ADMIN_TOKEN=
# SMS_PUBLIC_URL=https://clevertap-clone.netlify.app
# SMS_TEST_RECIPIENTS=+12025550123
# SMS_ALLOWED_HOSTS=your-provider.example.com
# SMS_CREDENTIALS_JSON={"twilio":{"authToken":""},"nexmo":{"apiKey":"","apiSecret":"","signatureSecret":"","signatureMethod":"sha256"},"generic":{"username":"","password":"","clientId":"","clientSecret":"","apiKey":"","callbackSecret":""}}
